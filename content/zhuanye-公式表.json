{
  "说明": "专业课常用公式速查（附加产出，来自原网页 FORMULAS 模块）",
  "液压": [
    {
      "名称": "压力与推力",
      "公式": "p = F/A　　F = pA"
    },
    {
      "名称": "流量与速度",
      "公式": "q = A·v　　v = q/A"
    },
    {
      "名称": "连续性方程",
      "公式": "q = A₁v₁ = A₂v₂"
    },
    {
      "名称": "运动黏度",
      "公式": "ν = μ/ρ"
    },
    {
      "名称": "泵理论流量",
      "公式": "qₜ = V·n"
    },
    {
      "名称": "泵的功率",
      "公式": "P = p·q　　Pᵢ = T·ω = 2πnT"
    },
    {
      "名称": "泵的效率",
      "公式": "ηv = q/qₜ　　η = ηv·ηm"
    },
    {
      "名称": "缸的有效面积",
      "公式": "A₁ = πD²/4　　A₂ = π(D²−d²)/4"
    },
    {
      "名称": "差动连接",
      "公式": "v = q/(A₁−A₂)　　F = p(A₁−A₂)"
    },
    {
      "名称": "马达转速",
      "公式": "n = q·ηv/V"
    },
    {
      "名称": "沿程压力损失",
      "公式": "Δp = λ·(l/d)·(ρv²/2)"
    },
    {
      "名称": "泵的驱动功率",
      "公式": "P = p·q/η"
    },
    {
      "名称": "油箱容量",
      "公式": "V = (6~7)·q"
    }
  ],
  "机械": [
    {
      "名称": "平面机构自由度",
      "公式": "F = 3n − 2PL − PH"
    },
    {
      "名称": "行程速比系数",
      "公式": "K = (180°+θ)/(180°−θ)"
    },
    {
      "名称": "压力角与传动角",
      "公式": "γ = 90° − α"
    },
    {
      "名称": "分度圆 / 基圆",
      "公式": "d = mz　　db = d·cosα"
    },
    {
      "名称": "齿距 / 齿厚",
      "公式": "p = πm　　s = e = p/2"
    },
    {
      "名称": "标准中心距",
      "公式": "a = m(z₁+z₂)/2"
    },
    {
      "名称": "齿轮传动比",
      "公式": "i₁₂ = ω₁/ω₂ = z₂/z₁ = db₂/db₁"
    },
    {
      "名称": "斜齿轮模数",
      "公式": "mt = mn/cosβ"
    },
    {
      "名称": "蜗杆传动比",
      "公式": "i = z₂/z₁（与直径无关）"
    },
    {
      "名称": "定轴轮系",
      "公式": "i = (−1)ᵐ·∏从动齿数/∏主动齿数"
    },
    {
      "名称": "周转轮系（转化法）",
      "公式": "i₁₃ᴴ = (n₁−nH)/(n₃−nH)"
    },
    {
      "名称": "速度不均匀系数",
      "公式": "δ = (ωmax−ωmin)/ωm"
    },
    {
      "名称": "飞轮转动惯量",
      "公式": "J ≈ ΔWmax/(ωm²·δ)"
    },
    {
      "名称": "瞬心数目",
      "公式": "K = N(N−1)/2"
    },
    {
      "名称": "哥氏加速度",
      "公式": "a_C = 2ω·v_r"
    },
    {
      "名称": "摩擦角 / 摩擦圆",
      "公式": "tanφ = f　　ρ = f_v·r"
    },
    {
      "名称": "机械效率",
      "公式": "η = 1 − Wf/Wd = F₀/F"
    },
    {
      "名称": "惯性力与惯性力偶",
      "公式": "F_I = −ma　　M_I = −Jα"
    },
    {
      "名称": "螺旋机构效率 / 自锁",
      "公式": "η = tanλ/tan(λ+φv)　　λ ≤ φv"
    },
    {
      "名称": "差动螺旋位移",
      "公式": "s = (l₁−l₂)·φ/2π"
    },
    {
      "名称": "单万向节瞬时传动比",
      "公式": "ω₂/ω₁ = cosα/(1−sin²α·cos²φ)"
    }
  ]
}